# Variáveis do docker-compose.yml. Copie para .env e preencha.
# NUNCA comite o .env real.

APP_ENV=production
LOG_LEVEL=info

# Porta publicada no loopback do host; o proxy existente encaminha para ela.
APP_PORT=8080

POSTGRES_DB=pacsweb
POSTGRES_USER=pacsweb
POSTGRES_PASSWORD=<SECRET>

# DSN da role runtime SEM superuser/DDL, provisionada separadamente.
# Use senha percent-encoded na URL; não reutilize POSTGRES_PASSWORD.
APP_DATABASE_URL=postgres://pacsweb_runtime:<SECRET>@postgres:5432/pacsweb?sslmode=disable
# Origem HTTPS pública exata do Nginx Proxy Manager.
PUBLIC_ORIGIN=https://pacs.example.invalid
# CIDR(s) do peer proxy real vistos pelo container; vazio ignora X-Forwarded-For.
TRUSTED_PROXY_CIDRS=

# Exige HTTPS no navegador. Só desligue em teste local sem TLS.
COOKIE_SECURE=true

SESSION_ABSOLUTE_TTL=12h
SESSION_IDLE_TTL=30m
LOGIN_RATE_ATTEMPTS=10
LOGIN_RATE_WINDOW=5m

# Chave mestra que cifra credenciais do Orthanc em repouso.
# Gere com: docker compose run --rm app pacs-server keygen
# Obrigatória quando APP_ENV=production. Guarde fora do repositório.
PACS_MASTER_KEY=<SECRET>
