# PACS Web Municipal — backend
# Copie para .env e preencha. NUNCA comite o .env real.
# Valores sensíveis estão marcados como <SECRET>.

# ── Aplicação ────────────────────────────────────────────────────────────────
# development | production
APP_ENV=development

# Endereço de escuta. Em produção, atrás do proxy, normalmente 0.0.0.0:8080.
HTTP_ADDR=127.0.0.1:8080

# debug | info | warn | error
LOG_LEVEL=info

# ── PostgreSQL da NOVA aplicação ─────────────────────────────────────────────
# Banco exclusivo do PACS Web. NÃO aponte para o PostgreSQL interno do Orthanc.
DATABASE_URL=postgres://pacsweb:<SECRET>@127.0.0.1:55432/pacsweb?sslmode=disable

# ── Sessões ──────────────────────────────────────────────────────────────────
# Prazo absoluto: encerra a sessão mesmo em uso contínuo.
SESSION_ABSOLUTE_TTL=12h
# Prazo por inatividade.
SESSION_IDLE_TTL=30m

# Cookie Secure. Em produção é obrigatório e não pode ser desligado.
# Em desenvolvimento sobre HTTP, deixe vazio ou false.
COOKIE_SECURE=false

# ── Origens ──────────────────────────────────────────────────────────────────
# Deixe VAZIO quando frontend e backend compartilham a origem — que é o caso
# tanto em produção (STATIC_DIR ou proxy) quanto em desenvolvimento (proxy do
# Vite). Preencha apenas origens absolutas e explícitas, separadas por vírgula.
# Nunca use "*".
ALLOWED_ORIGINS=

# Diretório com o build do frontend (dist/). Preenchido, o backend serve o SPA
# na mesma origem da API e o CORS deixa de ser necessário.
STATIC_DIR=

# ── Proteção do login ────────────────────────────────────────────────────────
LOGIN_RATE_ATTEMPTS=10
LOGIN_RATE_WINDOW=5m

# ── Encerramento ─────────────────────────────────────────────────────────────
SHUTDOWN_TIMEOUT=15s

# ── Chave mestra ─────────────────────────────────────────────────────────────
# Cifra as credenciais do Orthanc em repouso (AES-256-GCM).
# Gere com: go run ./cmd/server keygen
# Não fica no banco, não vai para o frontend, não entra no Git nem em log.
# Obrigatória quando APP_ENV=production; sem ela, em desenvolvimento, a
# configuração do PACS é salva mas a credencial não pode ser guardada.
# Trocar a chave torna ilegíveis as credenciais já cifradas.
PACS_MASTER_KEY=<SECRET>
